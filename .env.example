# Gemini API Key for Agent reasoning and RAG synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model name to use
LLM_MODEL=gemini-1.5-flash

# Database URL for SQLite
DATABASE_URL=sqlite:///data/database/parcelpilot.db

# Vector store root path
VECTORSTORE_PATH=data/vectorstore/chroma

# Dataset Snapshot Time (read from Excel README). Use this timestamp for all time calculations.
# Set by initialization script, default fallback is provided in config.py
DATASET_SNAPSHOT_TIME=2024-03-31T23:59:59Z
